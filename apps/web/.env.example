# apps/web (Squiggletale website + API + admin). Copy to .env and fill in. Port 7720.

# --- required ---
# Local Postgres for the device ledger, shares, flags, admin auth.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/onceupon
# better-auth signing secret (admin login). At least 32 characters.
BETTER_AUTH_SECRET=replace-me-with-32-plus-random-chars

# --- origins ---
# Admin/auth base URL. Defaults to http://localhost:7720.
BETTER_AUTH_URL=http://localhost:7720
# Public website/API origin used to build client config URLs (shop, redeem, privacy…).
# Defaults to BETTER_AUTH_URL.
PUBLIC_ORIGIN=http://localhost:7720
# Comma-separated origins allowed to call /api/* from the studio (CORS).
CORS_ORIGINS=http://localhost:7710,http://localhost:7711

# --- admin allow-list ---
# Comma-separated emails permitted to create/use an admin account. Everyone else is refused.
ADMIN_EMAILS=you@example.com

# --- device tokens ---
# HMAC secret for opaque device tokens (at least 32 chars). Defaults to `${BETTER_AUTH_SECRET}:device`.
DEVICE_TOKEN_SECRET=

# --- upstream keys (all optional; features degrade without them) ---
# Anthropic key for the drawing relay (/api/app/draw). Missing = relay returns 503 upstream.
ANTHROPIC_API_KEY=
# Deepgram streaming STT (ears token grant).
DEEPGRAM_API_KEY=
# OpenAI realtime transcription (ears token) — alternative ears vendor.
OPENAI_API_KEY=
# Stripe (website gift-code purchases).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Resend (operational alert emails). Missing = alerts are only stored, not emailed.
RESEND_API_KEY=
# Where operational alerts are emailed.
ALERT_EMAIL=

# --- Apple ---
# App bundle id used to validate App Store receipts/notifications. Defaults to BRAND.bundleId.
APPLE_BUNDLE_ID=com.quickgame.squiggletale
# Numeric App Store app id (App Store Connect). Optional.
APPLE_APP_APPLE_ID=6815029998   # App Store Connect app id for Squiggletale (needed for Production receipt checks)
# Sandbox | Production
APPLE_ENVIRONMENT=Sandbox

# --- studio ---
# Path (relative to apps/web) to the studio single-file build served at /app.
STUDIO_DIST=../../dist-hosted
