{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["bun", "node", "react"]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "modules/**/*.ts",
    "types/**/*.d.ts",
    "app.config.ts",
    "index.ts",
    "expo-env.d.ts",
    "../../packages/shared/src/**/*.ts"
  ]
}
