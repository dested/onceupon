# Hosted-mode build (`vite --mode hosted`): the studio talks to the server relay/meter instead of a
# browser-direct API key. For local dev against the web app, create `.env.hosted.local` (gitignored)
# with `VITE_API_ORIGIN=http://localhost:7720`. In production the API is same-origin, so it stays blank.
VITE_HOSTED=1
VITE_API_ORIGIN=
